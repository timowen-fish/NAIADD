rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isActiveAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isActiveAdmin();

      allow create: if isActiveAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "viewer"
          && request.resource.data.active == true
          && request.resource.data.keys().hasAll([
            "uid",
            "email",
            "displayName",
            "role",
            "active",
            "createdAt",
            "updatedAt",
            "lastLoginAt"
          ])
          && request.resource.data.keys().hasOnly([
            "uid",
            "email",
            "displayName",
            "role",
            "active",
            "createdAt",
            "updatedAt",
            "lastLoginAt"
          ])
        );

      allow update: if isActiveAdmin()
        || (
          isOwner(userId)
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "email",
              "displayName",
              "updatedAt",
              "lastLoginAt"
            ])
        );

      allow delete: if isActiveAdmin();
    }

    /*
      NAIADD controlled reference lists.

      All authenticated users may read these values so data-entry dropdowns
      work online. Only active administrators may publish, replace, or delete
      reference-list documents.
    */
    match /referenceData/{listId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isActiveAdmin();
    }

    /*
      NAIADD species catalog.

      The species list is readable by all authenticated users and writable
      only by active administrators.
    */
    match /species/{speciesId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isActiveAdmin();
    }

    match /submissions/{submissionId} {
      allow read:
        if isActiveAdmin()
        || (
          isSignedIn()
          && resource.data.metadata.ownerUid == request.auth.uid
        );

      allow create:
        if isSignedIn()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasAll([
          "schemaVersion",
          "metadata",
          "payload",
          "processing",
          "history"
        ])
        && request.resource.data.metadata.ownerUid == request.auth.uid
        && request.resource.data.metadata.submittedByUid == request.auth.uid
        && request.resource.data.metadata.specimenFormType in [
          "standard_mussel",
          "quads",
          "musselrama"
        ]
        && request.resource.data.payload.keys().hasAll([
          "location",
          "survey",
          "specimens"
        ])
        && request.resource.data.payload.specimens is list
        && request.resource.data.processing.businessStatus == "Queued"
        && request.resource.data.processing.processingState == "Pending";

      allow update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    match /publishedDeltas/{deltaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isActiveAdmin();

      match /{document=**} {
        allow read: if isSignedIn();
        allow create, update, delete: if isActiveAdmin();
      }
    }

    match /deltaIndex/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isActiveAdmin();
    }

    match /snapshotKeys/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isActiveAdmin();
    }
  }
}
