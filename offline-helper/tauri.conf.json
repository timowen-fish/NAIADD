{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAIADD Offline Helper",
  "version": "1.0.0",
  "identifier": "org.naiadd.offlinehelper",
  "build": {
    "beforeDevCommand": "npm run sync:app && npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run sync:app && npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "NAIADD Offline Helper",
        "width": 820,
        "height": 620,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": [
      "naiadd-app/**/*"
    ]
  }
}
